{
	"compilerOptions": {
		"target": "ES2020",
		"module": "esnext",
		"jsx": "react",
		"sourceMap": true,
		"outDir": "dist",
		"rootDir": "src",
		"strict": true,
		"moduleResolution": "bundler",
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"declaration": true,
		"declarationDir": "dist/types",
		"emitDeclarationOnly": true
	}
}
