{
  "name": "react-mobile-keyboard-opener",
  "version": "1.0.2",
  "description": "React component for opening the keyboard on mobile websites with user interactions.",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "package.json",
    "README.md"
  ],
  "private": false,
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "yarn prebuild && tsc -p tsconfig.build.json && rollup -c",
    "watch": "(http-server -c-1 -p 8081 -o &) && tsc -p tsconfig.build.json && rollup -cw",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "test": "vitest run"
  },
  "keywords": [
    "react",
    "react-component",
    "mobile",
    "ios",
    "android",
    "keyboard",
    "input"
  ],
  "author": "Howard Tang <t919901@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/haotang0619/react-mobile-keyboard-opener",
  "repository": {
    "type": "git",
    "url": "https://github.com/haotang0619/react-mobile-keyboard-opener.git"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.12.0",
    "http-server": "^14.1.1",
    "jsdom": "^30.1.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rollup": "^4.63.4",
    "rollup-plugin-dts": "^6.5.1",
    "rollup-plugin-peer-deps-external": "^2.2.4",
    "rollup-plugin-postcss": "^4.0.2",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "react": "^17.0.2 || ^18.0.0 || ^19.0.0",
    "react-dom": "^17.0.2 || ^18.0.0 || ^19.0.0"
  },
  "dependencies": {}
}
